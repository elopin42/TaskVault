# Copy to .env (gitignored). Every value has a safe dev default except the secret
# key when DJANGO_DEBUG is off.

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Paris
# Set to 1 behind an HTTPS proxy (secure cookies + SSL redirect).
DJANGO_FORCE_HTTPS=0
# Bump to bust the 30-day static cache after editing lowbid-*.css / lowbid-*.js.
LOWBID_ASSET_VERSION=

# --- Database --- (SQLite in data/db.sqlite3 unless DJANGO_DB_HOST is set)
# Alternate SQLite file for a throwaway run (make e2e sets data/e2e.sqlite3).
LOWBID_SQLITE_PATH=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=lowbid
DJANGO_DB_USER=lowbid
DJANGO_DB_PASSWORD=

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Payment asset. Defaults to Circle's testnet USDC (the legacy STELLAR_USDC_* names still work).
# STELLAR_ASSET_CODE=XLM with an EMPTY issuer = native XLM: direct payments and balances only — the
# Trustless Work escrow needs an issuer, so LOWBID_PAYMENT_MODE falls back to "direct" (warning logged).
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Trustless Work (Soroban escrow) ---
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=
# escrow (one Trustless Work single-release escrow PER TASK, deployed + funded by the company once a
# freelance is chosen) | direct (one signed payment at each validation) | empty = auto (escrow when the
# API key is set, else direct). Restart after a change.
LOWBID_PAYMENT_MODE=
# Platform wallet (G…): dispute resolver + fee receiver (needs the asset trustline).
LOWBID_PLATFORM_ADDRESS=
# Trustless Work platformFee (JSON number; unit unverified on v1 — keep 1, read back after first deploy).
LOWBID_PLATFORM_FEE=1
# Arbiter wallet: signs resolve-dispute (and is the only wallet that sees /litiges/); defaults to the platform
# wallet; may be a Stellar multisig account, see STELLAR_NOTES §1.3 (the UI collects one Freighter signature).
LOWBID_DISPUTE_RESOLVER=

# --- Review window and revisions ---
# Days the company has to validate a delivery (or request changes) before the review window is over —
# computed when a page is read, no timer. Empty = 7.
LOWBID_REVIEW_DAYS=7
# How many times a company may send a delivery back for changes on one task (then it has to validate). Empty = 2.
LOWBID_MAX_REVISIONS=2

# --- Delivery links ---
# Comma-separated hosts whose delivery / full-deliverable links show without the "Unknown domain — open with
# care" warning. An entry also covers its subdomains (vercel.app covers my-app.vercel.app). Empty = the default.
LOWBID_TRUSTED_LINK_HOSTS=github.com,gitlab.com,vercel.app,netlify.app

# --- Publication deposit (anti ghost listing) ---
# Active only when enabled AND the payment mode is "escrow": the company locks a deposit in a Trustless
# Work escrow before its project takes applications. 1 = on (default), 0 = off.
LOWBID_DEPOSIT_ENABLED=1
# Deposit = max(rate × project budget, minimum); a top-up for tasks added later = max(rate × gap, top-up minimum).
LOWBID_DEPOSIT_RATE=0.01
LOWBID_DEPOSIT_MIN=5
LOWBID_DEPOSIT_TOPUP_MIN=1
# Days to choose a freelancer once the first application arrived (else the deposit is forfeited).
LOWBID_CHOICE_DAYS=14
# Days after publication with no application after which the company may reclaim the deposit.
LOWBID_NO_APPLICATION_DAYS=30
# Guarantee fund wallet (G…, public): receives forfeited deposits. Needs the asset trustline and must
# differ from LOWBID_PLATFORM_ADDRESS.
LOWBID_GUARANTEE_FUND_ADDRESS=
# Server-held TESTNET secrets (S…) — never commit real ones. The platform secret's public key must equal
# LOWBID_PLATFORM_ADDRESS (it signs the refund and opens the dispute); the deposit resolver secret is a
# SECOND key (the deposit escrow's disputeResolver: the contract refuses a dispute opened by the resolver).
# Missing → `manage.py check` warns and deposits stay disabled; invalid, mismatched or overlapping → it fails.
LOWBID_PLATFORM_SECRET=
LOWBID_DEPOSIT_RESOLVER_SECRET=

# --- Wallet login ---
WALLET_CHALLENGE_TTL_SECONDS=300

# --- Reputation ---
# "Verified GitHub" badge: the gist owner's GitHub account must be at least this many days old.
LOWBID_GITHUB_MIN_AGE_DAYS=365
# "Reliable payer" badge: distinct freelances paid with a confirmed Stellar transaction (and no dispute lost).
LOWBID_RELIABLE_PAYER_MIN_PARTNERS=3
# Optional GitHub token for api.github.com (raises the rate limit from 60/h). Never rendered, never logged.
LOWBID_GITHUB_TOKEN=

# --- Demo data (python manage.py seed_demo [--flush]) ---
# Wallets used by seed_demo as the four actors (company / freelance 1 / freelance 2 / arbiter, plus freelance 3): put the
# Freighter testnet accounts you control here so the seeded projects can be driven live. Empty = random.
# The arbiter wallet defaults to LOWBID_DISPUTE_RESOLVER (else LOWBID_PLATFORM_ADDRESS) when one is set:
# /litiges/ only opens for the wallet equal to that setting.
# LOWBID_DEMO_CLIENT=G...
# LOWBID_DEMO_FREELANCE1=G...
# LOWBID_DEMO_FREELANCE2=G...
# LOWBID_DEMO_ARBITER=G...
# Freelancer C: applies to T3 and is recommended by freelancer A (trust-network demo).
# LOWBID_DEMO_FREELANCE3=G...
