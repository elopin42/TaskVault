# Copy to .env (gitignored). Every value has a safe dev default except the secret
# key when DJANGO_DEBUG is off.

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Paris
# Set to 1 behind an HTTPS proxy (secure cookies + SSL redirect).
DJANGO_FORCE_HTTPS=0
# Bump to bust the 30-day static cache after editing lowbid-*.css / lowbid-*.js.
LOWBID_ASSET_VERSION=

# --- Database --- (SQLite in data/db.sqlite3 unless DJANGO_DB_HOST is set)
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=lowbid
DJANGO_DB_USER=lowbid
DJANGO_DB_PASSWORD=

# --- Stellar ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_CODE=USDC

# --- Trustless Work (Soroban escrow) ---
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=
# escrow | direct | empty = auto (escrow when the API key is set, else direct USDC payment).
LOWBID_PAYMENT_MODE=
# Platform wallet (G…): dispute resolver + fee receiver (needs a USDC trustline).
LOWBID_PLATFORM_ADDRESS=
# Trustless Work platformFee (JSON number; unit unverified on v1 — keep 1, read back after first deploy).
LOWBID_PLATFORM_FEE=1

# --- Wallet login ---
WALLET_CHALLENGE_TTL_SECONDS=300
